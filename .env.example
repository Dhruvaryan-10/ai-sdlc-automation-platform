# Copy this file to ".env" and fill in real values. Never commit ".env" to git.
#
# Every value below is validated once, at startup (app/utils/config.py). An
# out-of-range or misspelled value fails fast with a clear message instead of
# breaking mid-run. Ranges are noted per setting.

# Get this key from https://aistudio.google.com/app/apikey
# REQUIRED. Must be a real key — an empty value or the literal placeholder
# below is rejected. Surrounding whitespace is trimmed.
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model used by EVERY agent (single source: app/utils/llm.py).
# gemini-3.6-flash is listed in Google's Gemini API docs
# (https://ai.google.dev/gemini-api/docs/models). Google retires old names
# periodically. On Streamlit Cloud set this in the app's Secrets instead: a
# local .env is never deployed.
GEMINI_MODEL=gemini-3.6-flash

# Model creativity. Allowed range: 0.0–2.0 inclusive (0.0 = deterministic).
GEMINI_TEMPERATURE=0.3

# Gemini client timeout in seconds — bounds a hung connection, not a slow-but-live
# generation. Must be an integer >= 1. Default 900 (~2x the worst observed LLD run).
GEMINI_TIMEOUT_SECONDS=900

# SDK-level HTTP attempts per agent attempt (TOTAL requests, not retries:
# 0 and 1 both mean a single request). Keep 1: the SDK's retry ignores
# Google's 429 retry delay and multiplies with the application retries below.
GEMINI_MAX_RETRIES=1

# Application-level retry policy (app/utils/gemini_retry.py), shared by all agents.
# Attempts per Gemini call, 1-5. 503s use exponential backoff with jitter;
# daily-quota 429s are never retried.
GEMINI_RETRY_MAX_ATTEMPTS=3
# Most one call may wait between attempts, 0-300 seconds. A per-minute 429 is
# retried once, only if Google's requested delay fits; otherwise the user
# is told how long to wait. 0 = never wait (fail fast).
GEMINI_RETRY_MAX_WAIT_SECONDS=60

# Folders. Relative values resolve against the current working directory — run
# the app from the repository root (see README section 3) so they land in the
# expected place. The app creates them on demand.
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
LOG_DIR=logs

# Logging level: one of DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive).
LOG_LEVEL=INFO
