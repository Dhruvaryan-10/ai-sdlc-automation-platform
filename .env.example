# Copy this file to ".env" and fill in real values. Never commit ".env" to git.

# Get this key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model to use (check https://ai.google.dev/gemini-api/docs/models for current options —
# Google retires older model names periodically; gemini-3.5-flash is the current GA default)
GEMINI_MODEL=gemini-3.5-flash

# Model creativity (0.0 = deterministic, 1.0 = very creative)
GEMINI_TEMPERATURE=0.3

# Folders (relative to project root)
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
LOG_DIR=logs

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
